  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"P@ssw0rd\",\n  \"role\": \"owner\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.response.to.be.successful;",
                  "});",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"P@ssw0rd\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.response.to.be.successful;",
                  "});",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "try {",
                  "    var json = pm.response.json();",
                  "    var token = json.token || json.accessToken || json.access_token || json.jwt || (json.data && json.data.token);",
                  "    if (token) {",
                  "        pm.environment.set('JWT', token);",
                  "        pm.test('JWT saved to environment', function () {",
                  "            pm.expect(pm.environment.get('JWT')).to.be.a('string');",
                  "        });",
                  "    } else {",
                  "        pm.test('No JWT found in response', function () {",
                  "            pm.expect(typeof token).to.not.eql('undefined');",
                  "        });",
                  "    }",
                  "} catch (e) {",
                  "    // response not JSON or other error",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
