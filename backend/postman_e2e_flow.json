{
  "info": {
    "name": "Rental Backend - E2E Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "End-to-end flow: register -> login -> create room -> create contract -> create bill -> mark paid -> register vehicle -> delete vehicle. Saves variables: JWT, USER_ID, ROOM_ID, CONTRACT_ID, BILL_ID, VEHICLE_ID"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "JWT", "value": "" },
    { "key": "ts", "value": "" },
    { "key": "USER_ID", "value": "" },
    { "key": "ROOM_ID", "value": "" },
    { "key": "CONTRACT_ID", "value": "" },
    { "key": "BILL_ID", "value": "" },
    { "key": "VEHICLE_ID", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Register",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user+{{ts}}@example.com\",\n  \"username\": \"user{{ts}}\",\n  \"password\": \"P@ssw0rd\",\n  \"full_name\": \"E2E Test\",\n  \"phone\": \"0900000000\",\n  \"role\": \"renter\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// generate timestamp for unique user",
              "pm.environment.set('ts', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201/200/409 (already exists)', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200,201,409,400]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user+{{ts}}@example.com\",\n  \"password\": \"P@ssw0rd\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login success', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
              "var json = pm.response.json();",
              "pm.environment.set('JWT', json?.data?.token || '');",
              "pm.environment.set('USER_ID', json?.data?.user?.id || '');",
              "pm.test('token set', function() { pm.expect(pm.environment.get('JWT')).to.not.equal(''); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Create Room",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"E2E Room {{ts}}\",\n  \"description\": \"Flow test room\",\n  \"price\": 2000000,\n  \"area_m2\": 20.0,\n  \"room_type\": \"PHONG_TRO\",\n  \"address\": \"Address\",\n  \"ward\": \"Ward\",\n  \"district\": \"District\",\n  \"city\": \"City\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/rooms"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create room status (may be 404 if rooms API not implemented)', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200,201,404,403,401]);",
              "});",
              "try {",
              "  var json = pm.response.json();",
              "  if (json?.data?.id) pm.environment.set('ROOM_ID', json.data.id);",
              "} catch(e) {}"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Create Contract",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"renter_id\": {{USER_ID}},\n  \"start_date\": \"2026-05-01\",\n  \"end_date\": \"2027-05-01\",\n  \"monthly_rent\": 2500000,\n  \"electricity_price\": 3000,\n  \"water_price\": 8000\n}"
        },
        "url": "{{baseUrl}}/api/v1/rooms/{{ROOM_ID}}/contracts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create contract status', function () { pm.expect(pm.response.code).to.be.oneOf([200,201,400,403,401,404]); });",
              "try {",
              "  var json = pm.response.json();",
              "  if (json?.data?.id) pm.environment.set('CONTRACT_ID', json.data.id);",
              "} catch(e) {}"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Create Bill (with meters)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"billingMonth\": \"2026-05-01\",\n  \"elecCurr\": 1200,\n  \"waterCurr\": 30,\n  \"extraFee\": 0,\n  \"extraNote\": \"e2e\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/contracts/{{CONTRACT_ID}}/bills"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create bill status', function () { pm.expect(pm.response.code).to.be.oneOf([200,201,400,403,401,404]); });",
              "try {",
              "  var json = pm.response.json();",
              "  if (json?.data?.id) pm.environment.set('BILL_ID', json.data.id);",
              "} catch(e) {}"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Mark Bill Paid",
      "request": {
        "method": "PATCH",
        "header": [ { "key": "Authorization", "value": "Bearer {{JWT}}" } ],
        "url": "{{baseUrl}}/api/v1/bills/{{BILL_ID}}/paid"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mark paid status', function () { pm.expect(pm.response.code).to.be.oneOf([200,201,400,403,401,404]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - Register Vehicle",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"licensePlate\": \"E2E-{{ts}}\",\n  \"vehicleType\": \"xe_may\",\n  \"renterId\": {{USER_ID}},\n  \"imageUrl\": \"https://example.com/e2e.png\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/rooms/{{ROOM_ID}}/vehicles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create vehicle status', function () { pm.expect(pm.response.code).to.be.oneOf([200,201,400,403,401,404]); });",
              "try {",
              "  var json = pm.response.json();",
              "  if (json?.data?.id) pm.environment.set('VEHICLE_ID', json.data.id);",
              "} catch(e) {}"
            ]
          }
        }
      ]
    },
    {
      "name": "8 - Delete Vehicle",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{JWT}}" } ],
        "url": "{{baseUrl}}/api/v1/vehicles/{{VEHICLE_ID}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('delete vehicle status', function () { pm.expect(pm.response.code).to.be.oneOf([200,204,400,403,401,404]); });"
            ]
          }
        }
      ]
    }
  ]
}

